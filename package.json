{
  "name": "@quest-ui/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editable pixel React components powered by Astryx and StyleX.",
  "exports": {
    ".": "./components/quest/index.ts",
    "./styles.css": "./components/quest/fonts.css"
  },
  "bin": {
    "quest-ui": "./dist-cli/quest.js"
  },
  "files": [
    "dist-cli",
    "components/quest",
    "docs",
    "llms.txt",
    "public/fonts",
    "public/r"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run build:cli && npm run registry && vite build",
    "build:cli": "tsc cli/quest.ts --outDir dist-cli --rootDir cli --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck --types node",
    "registry": "node scripts/build-registry.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:screenshots:update": "playwright test --update-snapshots",
    "verify:pre-consumer": "npm test && npm run test:e2e && npm run build && npm run engineering:check",
    "engineering:check": "engineering check",
    "engineering:baseline": "engineering baseline",
    "engineering:prune": "engineering prune",
    "engineering:skills": "engineering skills"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@stylexjs/stylex": "^0.19.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@kadajett/engineering": "file:.engineering/vendor/kadajett-engineering-0.5.0.tgz",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.13",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
